---
// The homepage. Each <section> below is one band of the page — ask the AI to
// add, remove, or reorder them. Every `km` field / class="km" line is the Khmer
// caption shown under the English.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const stats = [
  { value: '~48 km', label: 'from Siem Reap town to Phnom Kulen National Park', labelKm: 'ពីទីក្រុងសៀមរាបទៅឧទ្យានជាតិភ្នំគូលែន' },
  { value: '~5 min', label: 'walk from the road, through the forest', labelKm: 'ដើរពីផ្លូវកាត់ព្រៃប្រហែល ៥ នាទី' },
  { value: '$20', label: 'park ticket for foreign visitors', labelKm: 'សំបុត្រចូលឧទ្យានសម្រាប់ភ្ញៀវបរទេស' },
  { value: 'Free', label: 'for Cambodian visitors', labelKm: 'ឥតគិតថ្លៃសម្រាប់ជនជាតិខ្មែរ' },
];

const sights = [
  {
    icon: '🟠',
    title: 'Orange rock',
    text: 'Smooth orange rock formations that stand out against the green jungle around them.',
  },
  {
    icon: '🌄',
    title: 'Canyon views',
    text: 'From the edge, look out over the canyon and the mountain ranges beyond.',
  },
  {
    icon: '🥾',
    title: 'A short forest walk',
    text: 'Park by the road, then walk about five minutes to the cliff.',
  },
];

const steps = [
  {
    icon: '🌅',
    title: 'Leave early',
    titleKm: 'ចេញដំណើរពីព្រឹក',
    text: 'Start from Siem Reap in the morning. The road up Phnom Kulen is reported to be one-way: up in the morning, down in the afternoon. Aim to be going up before 11 AM.',
  },
  {
    icon: '🚗',
    title: 'Drive north',
    titleKm: 'បើកទៅទិសខាងជើង',
    text: 'It is about 48 km and takes roughly 1.5 to 2 hours by car or van. The road is rough in places.',
  },
  {
    icon: '🎟️',
    title: 'Pay the park ticket',
    titleKm: 'បង់សំបុត្រចូលឧទ្យាន',
    text: '$20 in cash for foreign visitors, free for Cambodians. The Angkor Pass does not cover it. Ask your driver where to pay.',
  },
  {
    icon: '🪧',
    title: 'Find the sign',
    titleKm: 'រកស្លាកសញ្ញា',
    text: 'Look for a small sign by the road. Park there, then walk about 5 minutes through the forest to the cliff.',
  },
];

const tips = [
  {
    icon: '☀️',
    title: 'Best time',
    text: 'Early morning has the best light and fewer people. The dry season (about November to February) is cooler and clearer. In the wet season, start early to miss the afternoon storms.',
  },
  {
    icon: '💵',
    title: 'Bring cash',
    text: 'The park ticket is paid in cash and is separate from the Angkor Pass. Cambodians enter free.',
  },
  {
    icon: '🚐',
    title: 'Getting around',
    text: 'Most visitors hire a car or van with a driver. Reports about tuk-tuks differ, so ask before you book.',
  },
  {
    icon: '👟',
    title: 'Wear shoes with grip',
    text: 'The smooth rock can be slippery, most of all when it is wet.',
  },
  {
    icon: '⚠️',
    title: 'Stay back from the edge',
    text: 'Take your photos from a safe spot, and never climb on wet rock.',
  },
  {
    icon: '🙏',
    title: 'Show respect',
    text: 'Phnom Kulen is a sacred mountain. Dress modestly at temples and take your rubbish with you.',
  },
];

const nearby = [
  {
    icon: '💧',
    title: 'Kulen Waterfall',
    text: 'Two waterfalls, about 4–5 m and 15–20 m high. How much water you see depends on the season and the rain.',
  },
  {
    icon: '🛕',
    title: 'Preah Ang Thom',
    text: 'A hilltop pagoda with a large reclining Buddha, reached by steps past a Garuda statue.',
  },
  {
    icon: '🔱',
    title: 'River of a Thousand Lingas',
    text: 'More than a thousand lingas, symbols of the god Shiva, carved into the stones of the river.',
  },
  {
    icon: '🏛️',
    title: 'More temples',
    text: 'Many day tours also stop at Banteay Srei and Beng Mealea temples.',
  },
];

const faqs = [
  {
    q: 'Is Poeng Ta Kho a national park?',
    qKm: 'តើ Poeng Ta Kho ជាឧទ្យានជាតិឬទេ?',
    a: 'Not by itself. It is a cliff viewpoint on the road to Phnom Kulen National Park. The park’s rules and ticket apply.',
  },
  {
    q: 'Does the Angkor Pass cover it?',
    qKm: 'តើសំបុត្រអង្គរគ្របដណ្តប់ទីនេះទេ?',
    a: 'No. Phnom Kulen has its own ticket: $20 in cash for foreign visitors, free for Cambodians. Prices can change, so ask locally.',
  },
  {
    q: 'How long should I plan?',
    qKm: 'ត្រូវចំណាយពេលប៉ុន្មាន?',
    a: 'The cliff itself is a short stop. Most people combine it with the waterfall and the temple, which makes it a full day trip from Siem Reap.',
  },
  {
    q: 'Is it safe?',
    qKm: 'តើមានសុវត្ថិភាពទេ?',
    a: 'It is fine for most visitors if you are careful. The rock can be slippery, so wear shoes with grip and keep well back from the edge.',
  },
  {
    q: 'Can I go by tuk-tuk?',
    qKm: 'តើអាចទៅដោយតុកតុកបានទេ?',
    a: 'Reports differ. The road up the mountain is steep and rough, and several guides recommend a car or van. Ask your driver before you book.',
  },
];

// Treetops for the illustration. A tiny seeded random keeps them the same on every build.
let seed = 7;
const rand = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const treetops = Array.from({ length: 46 }, (_, i) => {
  const row = i % 3;
  return {
    cx: Math.round(rand() * 640 - 20),
    cy: Math.round(450 + row * 28 + rand() * 20),
    r: Math.round(30 + rand() * 24),
    dark: rand() > 0.5,
  };
}).filter((t) => t.cx > 300 || t.cy > 490);
---

<Base title="The Amazing Cliff of Phnom Kulen">
  <Header />

  <main>
    <!-- HERO -->
    <section class="relative overflow-hidden">
      <div class="pointer-events-none absolute -top-40 -right-40 size-[36rem] rounded-full bg-sun/25 blur-3xl"></div>
      <div class="pointer-events-none absolute -bottom-40 -left-40 size-[30rem] rounded-full bg-leaf/15 blur-3xl"></div>

      <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-4 py-16 sm:px-6 sm:py-24 lg:grid-cols-2">
        <div>
          <p class="inline-flex items-center gap-2 rounded-full border border-ink/10 bg-white/70 px-3 py-1 text-sm font-medium">
            <span class="size-2 rounded-full bg-leaf"></span>
            Siem Reap Province, Cambodia
            <span lang="km" class="font-khmer opacity-70">ខេត្តសៀមរាប</span>
          </p>
          <h1 class="mt-6 font-display text-5xl leading-[1.02] font-extrabold tracking-tight text-balance sm:text-6xl lg:text-7xl">
            The <span class="text-brand">Amazing Cliff</span> of Phnom Kulen.
          </h1>
          <p lang="km" class="mt-4 text-xl text-ink/70">ច្រាំងថ្មអស្ចារ្យនៃភ្នំគូលែន</p>
          <p class="mt-6 max-w-xl text-lg text-muted">
            Poeng Ta Kho is a lookout of smooth orange rock above a deep green canyon. It is a short walk from the road, on the way up to Phnom Kulen National Park.
            <span class="km" lang="km">ថ្មពណ៌ទឹកក្រូចរលោង នៅលើជ្រលងភ្នំបៃតងជ្រៅ។ ដើរបន្តិចពីផ្លូវ នៅតាមផ្លូវឡើងទៅឧទ្យានជាតិភ្នំគូលែន។</span>
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#visit" class="rounded-full bg-brand px-6 py-3 font-semibold text-paper shadow-lg shadow-brand/25 transition hover:bg-brand-dark">
              Plan your visit → <span lang="km" class="font-khmer font-normal opacity-80">រៀបចំដំណើរទស្សនា</span>
            </a>
            <a href="#nearby" class="rounded-full border border-ink/15 bg-white px-6 py-3 font-semibold transition hover:border-ink/40">
              What’s nearby <span lang="km" class="font-khmer font-normal opacity-60">នៅជិតៗ</span>
            </a>
          </div>
        </div>

        <!-- Illustration: an orange rock cliff above the jungle, at sunrise -->
        <div class="relative">
          <svg
            viewBox="0 0 600 520"
            role="img"
            aria-label="Illustration of an orange rock cliff above a green jungle canyon at sunrise, with a person standing at the edge"
            class="h-auto w-full rounded-3xl shadow-2xl"
          >
            <defs>
              <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#f4b862"></stop>
                <stop offset="0.55" stop-color="#fbe0ae"></stop>
                <stop offset="1" stop-color="#fbf5ea"></stop>
              </linearGradient>
            </defs>
            <rect width="600" height="520" fill="url(#sky)"></rect>
            <circle cx="455" cy="150" r="96" class="fill-sun" opacity="0.25"></circle>
            <circle cx="455" cy="150" r="58" class="fill-sun"></circle>

            <!-- far and middle hills -->
            <path d="M0 330 C80 290 140 300 220 320 C300 340 360 280 450 285 C520 290 560 310 600 300 L600 520 L0 520Z" class="fill-leaf" opacity="0.35"></path>
            <path d="M0 385 C90 355 170 375 250 365 C340 352 420 335 500 350 C550 359 580 355 600 350 L600 520 L0 520Z" class="fill-leaf" opacity="0.65"></path>

            <!-- the cliff: shaded face, then sunlit top -->
            <path d="M0 250 C60 230 120 235 170 215 C230 190 300 200 340 230 C372 254 372 292 352 330 L346 520 L0 520Z" class="fill-brand"></path>
            <path d="M0 250 C60 230 120 235 170 215 C230 190 300 200 340 230 C350 238 357 247 361 257 C300 236 230 234 170 256 C120 276 60 270 0 288Z" class="fill-rock"></path>
            <g class="stroke-brand-dark" fill="none" stroke-width="3" stroke-linecap="round" opacity="0.35">
              <path d="M0 335 C100 322 220 340 346 326"></path>
              <path d="M0 385 C110 372 230 392 347 376"></path>
              <path d="M0 440 C120 428 240 448 349 432"></path>
            </g>

            <!-- a visitor at the edge -->
            <g class="fill-ink">
              <circle cx="207" cy="187" r="4.5"></circle>
              <rect x="203.5" y="192" width="7" height="12" rx="3"></rect>
            </g>

            <!-- jungle canopy in front -->
            {treetops.map((t) => <circle cx={t.cx} cy={t.cy} r={t.r} class={t.dark ? 'fill-ink' : 'fill-leaf'} opacity={t.dark ? 0.85 : 1}></circle>)}
          </svg>
        </div>
      </div>
    </section>

    <!-- QUICK FACTS -->
    <section class="border-y border-ink/10 bg-white">
      <dl class="mx-auto grid max-w-6xl grid-cols-2 gap-8 px-4 py-10 sm:px-6 md:grid-cols-4">
        {
          stats.map((s) => (
            <div>
              <dd class="font-display text-4xl font-extrabold text-brand">{s.value}</dd>
              <dt class="mt-1 text-sm font-normal text-muted">
                {s.label}
                <span class="km" lang="km">{s.labelKm}</span>
              </dt>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- ABOUT -->
    <section id="about" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-20 sm:px-6 sm:py-28">
      <p class="font-semibold text-brand">The cliff <span lang="km" class="font-khmer font-normal">· ច្រាំងថ្ម</span></p>
      <h2 class="mt-2 max-w-2xl font-display text-4xl font-extrabold tracking-tight text-balance sm:text-5xl">
        A cliff of smooth orange rock, in the jungle.
      </h2>
      <p class="km mt-3 text-xl font-semibold sm:text-2xl" lang="km">ច្រាំងថ្មពណ៌ទឹកក្រូចរលោង នៅកណ្តាលព្រៃ។</p>

      <div class="mt-8 grid gap-6 lg:grid-cols-2">
        <p class="text-lg text-muted">
          Poeng Ta Kho is also called the “Amazing Cliff”. It is a rocky lookout where the smooth orange stone looks almost like another planet next to the green forest.
          <span class="km" lang="km">កន្លែងនេះក៏ហៅថា “ច្រាំងថ្មអស្ចារ្យ” ដែរ។ ថ្មពណ៌ទឹកក្រូចរលោង លេចចេញពីព្រៃបៃតង។</span>
        </p>
        <p class="text-lg text-muted">
          It is a viewpoint, not a park on its own. It sits on the road up to Phnom Kulen National Park, so most people stop here on the same trip as the waterfall and the temples.
        </p>
      </div>

      <ul class="mt-12 grid gap-4 sm:grid-cols-3">
        {
          sights.map((s) => (
            <li class="rounded-2xl border border-ink/10 bg-white p-6">
              <span class="text-3xl">{s.icon}</span>
              <h3 class="mt-4 font-display text-xl font-bold">{s.title}</h3>
              <p class="mt-2 text-muted">{s.text}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- GETTING THERE -->
    <section id="visit" class="scroll-mt-20 bg-white">
      <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28">
        <p class="font-semibold text-brand">Getting there <span lang="km" class="font-khmer font-normal">· ការធ្វើដំណើរ</span></p>
        <h2 class="mt-2 max-w-2xl font-display text-4xl font-extrabold tracking-tight text-balance sm:text-5xl">
          Four steps from Siem Reap to the edge.
        </h2>
        <p class="km mt-3 text-xl font-semibold sm:text-2xl" lang="km">បួនជំហានពីសៀមរាបទៅកាន់ច្រាំងថ្ម។</p>

        <ol class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {
            steps.map((s, i) => (
              <li class="rounded-2xl bg-paper p-6">
                <div class="flex items-center justify-between">
                  <span class="text-3xl">{s.icon}</span>
                  <span class="font-display text-sm font-bold text-ink/40">0{i + 1}</span>
                </div>
                <h3 class="mt-4 font-display text-xl font-bold">
                  {s.title}
                  <span class="km text-base" lang="km">{s.titleKm}</span>
                </h3>
                <p class="mt-2 text-muted">{s.text}</p>
              </li>
            ))
          }
        </ol>

        <p class="mt-8 rounded-2xl border border-sun/60 bg-sun/15 p-5 text-ink">
          <strong>Heads up:</strong> guides do not agree on exactly where the cliff is on the road. Some put it near the entrance to Phnom Kulen, others near the highest point. Ask your driver or a local to confirm the stop.
        </p>
      </div>
    </section>

    <!-- GOOD TO KNOW -->
    <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28">
      <p class="font-semibold text-brand">Good to know <span lang="km" class="font-khmer font-normal">· ដឹងមុនចេញដំណើរ</span></p>
      <h2 class="mt-2 font-display text-4xl font-extrabold tracking-tight sm:text-5xl">Before you go.</h2>
      <p class="km mt-3 text-xl font-semibold sm:text-2xl" lang="km">មុនពេលចេញដំណើរ។</p>

      <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          tips.map((t) => (
            <li class="rounded-2xl border border-ink/10 bg-white p-6">
              <span class="text-3xl">{t.icon}</span>
              <h3 class="mt-4 font-display text-lg font-bold">{t.title}</h3>
              <p class="mt-1 text-muted">{t.text}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- HISTORY -->
    <section class="bg-ink text-paper">
      <div class="mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 sm:py-28">
        <p class="font-display text-3xl leading-tight font-bold text-balance sm:text-5xl">
          More than 1,000 years ago, this mountain was a royal city. <span class="text-sun">The Khmer Empire began here.</span>
        </p>
        <p lang="km" class="km mt-6 text-xl sm:text-2xl">
          ជាង ១០០០ ឆ្នាំមុន ភ្នំនេះជាទីក្រុងរាជធានី។ ចក្រភពខ្មែរបានចាប់ផ្តើមនៅទីនេះ។
        </p>
        <p class="mx-auto mt-8 max-w-2xl text-paper/75">
          Then called Mahendraparvata, it is where King Jayavarman II was declared “chakravartin” (universal ruler), an event seen as the founding of the empire. In 2013, laser scans from the air (lidar) revealed about 30 temples nobody knew about.
        </p>
      </div>
    </section>

    <!-- NEARBY -->
    <section id="nearby" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-20 sm:px-6 sm:py-28">
      <p class="font-semibold text-brand">Nearby <span lang="km" class="font-khmer font-normal">· នៅជិតៗ</span></p>
      <h2 class="mt-2 max-w-2xl font-display text-4xl font-extrabold tracking-tight text-balance sm:text-5xl">
        More to see on Phnom Kulen.
      </h2>
      <p class="km mt-3 text-xl font-semibold sm:text-2xl" lang="km">កន្លែងផ្សេងទៀតនៅភ្នំគូលែន។</p>
      <p class="mt-4 max-w-2xl text-lg text-muted">
        Jayavarman-Norodom Phnom Kulen National Park covers about 374 km² and was set up in 1993. One park ticket covers the main sights below.
      </p>

      <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          nearby.map((n) => (
            <li class="rounded-2xl border border-ink/10 bg-white p-6">
              <span class="text-3xl">{n.icon}</span>
              <h3 class="mt-4 font-display text-lg font-bold">{n.title}</h3>
              <p class="mt-1 text-muted">{n.text}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- FAQ -->
    <section id="faq" class="mx-auto max-w-3xl scroll-mt-20 px-4 pb-20 sm:px-6 sm:pb-28">
      <h2 class="text-center font-display text-4xl font-extrabold tracking-tight">Questions</h2>
      <p class="km mt-2 text-center text-xl font-semibold" lang="km">សំណួរ</p>
      <div class="mt-10 divide-y divide-ink/10 border-y border-ink/10">
        {
          faqs.map((f) => (
            <details class="group py-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-lg font-bold">
                <span>
                  {f.q}
                  <span class="km text-base" lang="km">{f.qKm}</span>
                </span>
                <span class="text-2xl text-brand transition group-open:rotate-45">+</span>
              </summary>
              <p class="mt-3 text-muted">{f.a}</p>
            </details>
          ))
        }
      </div>
    </section>

    <!-- CALL TO ACTION -->
    <section class="px-4 pb-20 sm:px-6">
      <div class="mx-auto max-w-6xl rounded-3xl bg-brand px-6 py-16 text-center text-paper sm:py-20">
        <h2 class="font-display text-4xl font-extrabold tracking-tight text-balance sm:text-5xl">Ready for the view?</h2>
        <p class="mt-3 text-lg text-paper/90">Start early, bring cash, and wear shoes with good grip.</p>
        <p class="km mt-3 text-xl font-semibold sm:text-2xl" lang="km">ចេញដំណើរពីព្រឹក យកលុយសុទ្ធ ហើយពាក់ស្បែកជើងដែលមិនរអិល។</p>
        <a href="#top" class="mt-8 inline-block rounded-full bg-paper px-8 py-4 font-semibold text-ink transition hover:bg-sun">
          Back to the top ↑ <span lang="km" class="font-khmer font-normal">ត្រឡប់ទៅលើ</span>
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Base>
